+auto decompiler::inf_loop_iter(stmt_list const& stm, usize begin, usize end) -> bool
+{
+    // end is the jumpback; the candidate iterator is the statement just before it, reached by a
+    // jump from inside the loop body (a 'continue' that must still run the iterator).
+    if (!for_iter_ || end < begin + 2)
+        return false;
+
+    auto const& iter = stm.list.at(end - 1);
+
+    if (iter->is<stmt_jmp>() || iter->is<stmt_jmp_cond>() || iter->is<stmt_jmp_back>() || iter->is<stmt_jmp_switch>() || iter->is<stmt_return>())
+        return false;
+
+    return find_location_reference(stm, begin, end - 1, iter->label());
+}
